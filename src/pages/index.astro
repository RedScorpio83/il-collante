---
import BaseLayout from '../layouts/BaseLayout.astro';
import SolarChart from '../components/SolarChart.astro';
import Cover from '../components/Cover.astro';
import ArticleItem from '../components/ArticleItem.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SubscribeBox from '../components/SubscribeBox.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_TAGLINE, SITE_SUBTITLE } from '../consts';
import { getPostCategory } from '../utils/categories';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = allPosts[0];
const otherPosts = allPosts.slice(1);

const allProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('it-IT', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}
---

<BaseLayout title={SITE_TITLE}>
  <!-- Hero Section -->
  <section class="hero" aria-labelledby="titolo">
    <div>
      <h1 id="titolo">{SITE_TAGLINE}</h1>
      <p class="hero-lead">{SITE_SUBTITLE}</p>

      <SubscribeBox inline={true} />

      <div class="hero-links">
        <a href="#progetti">Esplora i progetti</a>
        <a href="/rss.xml">Segui via RSS</a>
      </div>
    </div>

    <SolarChart />
  </section>

  <!-- L'impianto in numeri -->
  <dl class="stats" aria-label="L'impianto in numeri">
    <div class="stat">
      <dt class="stat-l">fotovoltaico installato</dt>
      <dd class="stat-n">25,05<span class="u">kWp</span></dd>
    </div>
    <div class="stat">
      <dt class="stat-l">accumulo LiFePO4</dt>
      <dd class="stat-n">36<span class="u">kWh</span></dd>
    </div>
    <div class="stat">
      <dt class="stat-l">inverter, in isola e in rete</dt>
      <dd class="stat-n">2</dd>
    </div>
  </dl>

  <!-- Ultimi Articoli -->
  <section class="sec" id="articoli" aria-labelledby="h-articoli" style="border-top:0">
    <div class="sec-head">
      <h2 id="h-articoli">Ultimi articoli</h2>
      <div class="filters" role="group" aria-label="Filtra per argomento">
        <button type="button" data-f="tutti" aria-pressed="true">Tutti</button>
        <button type="button" data-f="energia" aria-pressed="false">Energia</button>
        <button type="button" data-f="ottim" aria-pressed="false">Ottimizzazione</button>
        <button type="button" data-f="proto" aria-pressed="false">Protocolli ed embedded</button>
        <button type="button" data-f="sist" aria-pressed="false">Sistemi e IA</button>
      </div>
    </div>

    <div class="articles">
      {featuredPost && (() => {
        const cat = getPostCategory(featuredPost.data.tags);
        return (
          <article class="featured">
            <Cover
              href={`/blog/${featuredPost.id}`}
              categoryClass={cat.class}
              label={cat.label}
              image={featuredPost.data.cover}
              alt={`Copertina di ${featuredPost.data.title}`}
            />
            <div class="meta">
              <span>{formatDate(featuredPost.data.pubDate)}</span>
              <span class={`cat ${cat.class}`}><i aria-hidden="true"></i>{cat.label}</span>
            </div>
            <h3><a href={`/blog/${featuredPost.id}`}>{featuredPost.data.title}</a></h3>
            <p>{featuredPost.data.description}</p>
            <a class="more" href={`/blog/${featuredPost.id}`}>Leggi l'articolo</a>
          </article>
        );
      })()}

      <div class="list" id="lista">
        {otherPosts.map((post) => (
          <ArticleItem
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            cover={post.data.cover}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Progetti e Infrastrutture -->
  <section class="sec" id="progetti" aria-labelledby="h-progetti">
    <div class="sec-head">
      <div>
        <h2 id="h-progetti">Progetti e infrastrutture</h2>
        <p class="sec-lead">Sistemi realizzati sul campo, con schema e documentazione.</p>
      </div>
      <a class="more" href="/projects">Vedi tutti i progetti</a>
    </div>
    <div class="projects-list">
      {allProjects.slice(0, 3).map((project) => (
        <ProjectRow
          id={project.id}
          title={project.data.title}
          description={project.data.description}
          technologies={project.data.technologies}
          status={project.data.status}
          highlight={project.data.highlight}
        />
      ))}
    </div>
  </section>

  <!-- Chi scrive -->
  <section class="sec" id="chi-scrive" aria-labelledby="h-chi">
    <div class="about">
      <h2 id="h-chi">Chi scrive</h2>
      <div>
        <p>Progetto sistemi. Non scrivo ogni riga: trovo la soluzione matematica e fisica, disegno l'architettura, coordino lo sviluppo e faccio da collante tra chi gestisce i sistemi e chi scrive il software.</p>
        <p>Ho ideato e realizzato impianti con due inverter, accumulo LiFePO4, ricarica dinamica dell'auto dal surplus e previsioni di produzione oraria.</p>
        <div class="about-links">
          <a class="btn btn--ghost" href="https://github.com/RedScorpio83" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="btn btn--ghost" href="/about">Chi sono</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
