---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_BRAND } from '../../consts';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('it-IT', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}
---

<BaseLayout
  title={`Progetti & Architetture | ${SITE_BRAND}`}
  description="I sistemi hardware, software, IoT e homelab realizzati e documentati sul campo da Alessandro Caliciotti."
>
  <div class="py-6 sm:py-10">
    <div class="mb-10">
      <span class="text-xs uppercase tracking-wider font-semibold [font-family:var(--f-display)] text-[var(--muted)]">
        Portfolio Tecnico
      </span>
      <h1
        class="mt-2 text-3xl sm:text-5xl font-extrabold text-[var(--ink)] tracking-tight leading-[1.05]"
        style='font-variation-settings: "wdth" 80, "opsz" 80;'
      >
        I Progetti e le Architetture
      </h1>
      <p class="mt-3 text-lg text-[var(--ink)] max-w-[66ch] leading-relaxed">
        Tutti i sistemi fisici, i microcontrollori, i nodi Proxmox e i software ideati, realizzati e collaudati sul campo.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        projects.map((project) => (
          <article class="p-6 rounded-md bg-[var(--surface)] border border-[var(--rule)] hover:border-[var(--ink)] transition-colors flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs [font-family:var(--f-display)] text-[var(--muted)] mb-2">
                <span>{formatDate(project.data.pubDate)}</span>
                <span class="px-2 py-0.5 rounded border border-[var(--rule)] uppercase text-[11px] font-semibold text-[var(--ink)]">
                  {project.data.status}
                </span>
              </div>
              <h2
                class="text-xl font-bold tracking-tight text-[var(--ink)] hover:text-[var(--grid)] transition-colors"
                style='font-variation-settings: "wdth" 90;'
              >
                <a href={`/projects/${project.id}`} class="no-underline">
                  {project.data.title}
                </a>
              </h2>
              <p class="mt-2 text-sm sm:text-base text-[var(--muted)] leading-relaxed line-clamp-3">
                {project.data.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-[var(--rule)] flex items-center justify-between flex-wrap gap-2 text-xs [font-family:var(--f-display)]">
              <div class="flex gap-1.5 flex-wrap">
                {project.data.technologies.slice(0, 4).map((tech) => (
                  <span class="px-2 py-0.5 bg-[var(--paper)] rounded text-[var(--ink)] border border-[var(--rule)]">
                    {tech}
                  </span>
                ))}
              </div>
              <a href={`/projects/${project.id}`} class="font-semibold text-[var(--ink)] hover:text-[var(--grid)]">
                Scheda tecnica →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
