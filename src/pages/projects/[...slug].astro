---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_BRAND } from '../../consts';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const formattedDate = new Intl.DateTimeFormat('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(project.data.pubDate);
---

<BaseLayout
  title={`${project.data.title} | ${SITE_BRAND}`}
  description={project.data.description}
>
  <div class="post-layout">
    <article class="post-main">
      <header class="post-head">
        <a class="more" href="/projects" style="margin-bottom: 1.25rem;">← Torna a tutti i progetti</a>
        <h1>{project.data.title}</h1>
        <div class="meta" style="margin-top: 1rem;">
          <span>Rilasciato il {formattedDate}</span>
          <span class="status">{project.data.status}</span>
        </div>
        {
          project.data.technologies && project.data.technologies.length > 0 && (
            <ul class="tags" style="margin-top: 1rem;">
              {project.data.technologies.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          )
        }
      </header>

      <div class="prose">
        {project.data.description && <p class="lede">{project.data.description}</p>}
        <Content />
      </div>

      {
        project.data.githubUrl && (
          <div class="post-end">
            <div class="discuss">
              <p>Codice sorgente, schemi e configurazioni sono disponibili su GitHub.</p>
              <a
                class="btn"
                href={project.data.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Repository GitHub
              </a>
            </div>
          </div>
        )
      }
    </article>
  </div>
</BaseLayout>
