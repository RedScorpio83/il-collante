    <!-- Etichette -->
    <text class="fill-[var(--sun-ink)] font-semibold text-[15px] [font-family:var(--f-display)]" x="356" y="50" text-anchor="end">Produzione prevista</text>
    <text class="fill-[var(--grid)] font-semibold text-[15px] [font-family:var(--f-display)]" x="640" y="136" text-anchor="middle">Consumo casa</text>
    <text class="fill-[var(--plan)] font-semibold text-[15px] [font-family:var(--f-display)] fadein late" x="422.8" y="146" text-anchor="middle">surplus</text>
    
    <!-- Traccia e Slot Ricarica EV -->
    <rect class="fill-[var(--rule)] fill-opacity-55" x="48" y="254" width="692" height="28" rx="3"/>
    <g class="fadein late">
      <rect class="fill-[var(--plan)]" x="365.2" y="254" width="115.3" height="28" rx="3"/>
      <text class="fill-[var(--on-plan)] font-bold text-[14px] [font-family:var(--f-display)]" x="422.8" y="273" text-anchor="middle">3,7 kW</text>
      <text class="fill-[var(--ink)] font-semibold text-[14px] [font-family:var(--f-display)]" x="492.5" y="273">Ricarica auto, scelta dal solver</text>
    </g>
  </svg>

  <figcaption class="mt-3 text-sm text-[var(--muted)] [font-family:var(--f-display)] leading-relaxed">
    Una giornata di esempio in una casa con fotovoltaico e auto elettrica. Il solver MILP assegna la ricarica nelle ore in cui il sole produce più di quanto la casa consuma.
  </figcaption>
</figure>
