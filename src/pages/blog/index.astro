---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleItem from '../../components/ArticleItem.astro';
import { getCollection } from 'astro:content';
import { SITE_BRAND } from '../../consts';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`Articoli | ${SITE_BRAND}`}
  description="Guide tecniche, note dal campo, protocolli industriali e riflessioni sull'integrazione hardware e intelligenza artificiale."
>
  <section class="sec" style="border-top:0">
    <div class="sec-head">
      <div>
        <h1>Tutti gli articoli</h1>
        <p class="sec-lead">Guide tecniche, note dal campo, protocolli industriali e modelli di ottimizzazione energetica.</p>
      </div>

      <div class="filters" role="group" aria-label="Filtra per argomento">
        <button type="button" data-f="tutti" aria-pressed="true">Tutti</button>
        <button type="button" data-f="energia" aria-pressed="false">Energia</button>
        <button type="button" data-f="ottim" aria-pressed="false">Ottimizzazione</button>
        <button type="button" data-f="proto" aria-pressed="false">Protocolli ed embedded</button>
        <button type="button" data-f="sist" aria-pressed="false">Sistemi e IA</button>
      </div>
    </div>

    <div class="list" id="lista">
      {
        posts.map((post) => (
          <ArticleItem
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            cover={post.data.cover}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
