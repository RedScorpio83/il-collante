---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import SeriesBlock from '../../components/SeriesBlock.astro';
import SubscribeBox from '../../components/SubscribeBox.astro';
import { getPostCategory } from '../../utils/categories';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return posts.map((post, index) => {
    const seriesPosts = post.data.series
      ? posts
          .filter((p) => p.data.series === post.data.series)
          .sort((a, b) => (a.data.seriesPart || 0) - (b.data.seriesPart || 0))
      : [];

    let nextPost = null;
    let nextPostIsSeries = false;

    if (seriesPosts.length > 1) {
      const currentSeriesIdx = seriesPosts.findIndex((p) => p.id === post.id);
      if (currentSeriesIdx !== -1 && currentSeriesIdx + 1 < seriesPosts.length) {
        nextPost = seriesPosts[currentSeriesIdx + 1];
        nextPostIsSeries = true;
      }
    }

    if (!nextPost) {
      nextPost = index + 1 < posts.length ? posts[index + 1] : (index > 0 ? posts[index - 1] : null);
    }

    return {
      params: { slug: post.id },
      props: { post, nextPost, nextPostIsSeries, seriesPosts },
    };
  });
}

const { post, nextPost, nextPostIsSeries, seriesPosts } = Astro.props;
const { Content, headings } = await render(post);

const category = getPostCategory(post.data.tags);
const formattedDate = new Intl.DateTimeFormat('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(post.data.pubDate);

const wordCount = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  type="article"
>
  <div class="post-layout">
    <Toc headings={headings} />

    <article class="post-main">
      {post.data.series && (
        <SeriesBlock
          seriesName={post.data.series}
          currentPart={post.data.seriesPart || 1}
          totalParts={seriesPosts.length || 4}
          items={seriesPosts.map((p) => ({
            title: p.data.title,
            url: `/blog/${p.id}`,
            part: p.data.seriesPart || 1,
          }))}
        />
      )}

      <header class="post-head">
        <h1>{post.data.title}</h1>
        <div class="meta">
          <span>{formattedDate}</span>
          <span>{readingTime} {readingTime === 1 ? 'minuto' : 'minuti'} di lettura</span>
          <span class={`cat ${category.class}`}><i aria-hidden="true"></i>{category.label}</span>
        </div>
      </header>

      <div class="prose">
        {post.data.description && <p class="lede">{post.data.description}</p>}
        <Content />
      </div>

      <div class="post-end">
        {nextPost && (
          <a class="next" href={`/blog/${nextPost.id}`}>
            <small>{nextPostIsSeries ? 'Prossimo nella serie' : 'Prossimo articolo'}</small>
            <strong>{nextPost.data.title}</strong>
          </a>
        )}

        <SubscribeBox />

        <div class="discuss">
          <p>Hai provato qualcosa di simile, o hai un dubbio su un passaggio? Scrivilo nella discussione.</p>
          <a
            class="btn btn--ghost"
            href="https://github.com/RedScorpio83/il-collante/discussions"
            target="_blank"
            rel="noopener noreferrer"
          >
            Partecipa su GitHub
          </a>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
