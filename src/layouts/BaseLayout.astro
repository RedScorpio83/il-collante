---
import '../styles/theme.css';
import '../styles/layout-wide.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  type = 'website',
} = Astro.props;

// Calcolo URL canonico e Open Graph usando il dominio reale configurato in astro.config.mjs
const siteUrl = Astro.site || new URL('https://www.ilcollante.it');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// og:image fallback su public/og-image.png (1200x630) se non specificata dall'articolo
const ogImageUrl = image
  ? new URL(image, canonicalURL).toString()
  : new URL('/og-image.png', siteUrl).toString();

const pageTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />

    <!-- Caricamento Google Fonts identico all'anteprima -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&display=swap"
    />

    <!-- Open Graph / LinkedIn / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Feed RSS -->
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
  </head>
  <body>
    <a class="skip" href="#main-content">Vai al contenuto</a>

    <div class="wrap">
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Script essenziali dal tema: filtri, copia codice, evidenziazione indice -->
    <script is:inline>
      (function () {
        /* Filtro per argomento */
        var buttons = document.querySelectorAll('.filters button');
        var items = document.querySelectorAll('#lista .item');
        if (buttons.length && items.length) {
          buttons.forEach(function (btn) {
            btn.addEventListener('click', function () {
              var f = btn.getAttribute('data-f');
              buttons.forEach(function (b) {
                b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
              });
              items.forEach(function (it) {
                it.hidden = !(f === 'tutti' || it.getAttribute('data-cat') === f);
              });
            });
          });
        }

        /* Pulsante copia sui blocchi di codice (e wrapping automatico per i pre generati da Markdown) */
        document.querySelectorAll('.prose pre').forEach(function (pre) {
          if (!pre.parentElement.classList.contains('codeblock')) {
            var wrap = document.createElement('div');
            wrap.className = 'codeblock';
            var code = pre.querySelector('code');
            if (code) {
              var langMatch = code.className.match(/language-([a-zA-Z0-9_-]+)/);
              if (langMatch) {
                var langSpan = document.createElement('span');
                langSpan.className = 'lang';
                langSpan.textContent = langMatch[1];
                wrap.appendChild(langSpan);
              }
            }
            var copyBtn = document.createElement('button');
            copyBtn.className = 'copy';
            copyBtn.type = 'button';
            copyBtn.textContent = 'Copia';
            pre.parentNode.insertBefore(wrap, pre);
            wrap.appendChild(copyBtn);
            wrap.appendChild(pre);
          }
        });

        document.querySelectorAll('.codeblock .copy').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var code = btn.parentElement.querySelector('code') || btn.parentElement.querySelector('pre');
            if (!code) return;
            var done = function (msg) {
              btn.textContent = msg;
              setTimeout(function () {
                btn.textContent = 'Copia';
              }, 1600);
            };
            try {
              navigator.clipboard.writeText(code.innerText).then(
                function () {
                  done('Copiato');
                },
                function () {
                  done('Non riuscito');
                }
              );
            } catch (e) {
              done('Non riuscito');
            }
          });
        });

        /* Indice: evidenzia la sezione che stai leggendo */
        var links = document.querySelectorAll('.toc a');
        if ('IntersectionObserver' in window && links.length) {
          var map = {};
          links.forEach(function (a) {
            var href = a.getAttribute('href');
            if (href && href.startsWith('#')) {
              map[href.slice(1)] = a;
            }
          });
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) {
                  links.forEach(function (a) {
                    a.removeAttribute('aria-current');
                  });
                  var a = map[en.target.id];
                  if (a) a.setAttribute('aria-current', 'true');
                }
              });
            },
            { rootMargin: '0px 0px -70% 0px' }
          );
          Object.keys(map).forEach(function (id) {
            var el = document.getElementById(id);
            if (el) io.observe(el);
          });
        }
      })();
    </script>
  </body>
</html>
