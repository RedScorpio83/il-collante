---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { getCollection } from 'astro:content';
import { SITE_BRAND } from '../../consts';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title={`Progetti & Infrastrutture | ${SITE_BRAND}`}
  description="I sistemi hardware, software, IoT e homelab realizzati e documentati sul campo da Alessandro Caliciotti."
>
  <section class="sec" style="border-top:0">
    <div class="sec-head">
      <div>
        <h1>Progetti e infrastrutture</h1>
        <p class="sec-lead">Tutti i sistemi fisici, i microcontrollori, i nodi Proxmox e i software ideati, realizzati e collaudati sul campo.</p>
      </div>
    </div>

    <div class="projects-list">
      {
        projects.map((project) => (
          <ProjectRow
            id={project.id}
            title={project.data.title}
            description={project.data.description}
            technologies={project.data.technologies}
            status={project.data.status}
            highlight={project.data.highlight}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
