---
import { defaultSolarChartData, type SolarChartConfig } from '../data/solarChartData';

interface Props {
  data?: SolarChartConfig;
}

const { data = defaultSolarChartData } = Astro.props;
const evMidX = data.evSlot.x + data.evSlot.width / 2;
const evTextX = data.evSlot.x + data.evSlot.width + 12;
---

<figure class="chart">
  <div class="chart-head">
    <strong>{data.title}</strong>
    <span class="status">{data.statusLabel}</span>
  </div>
  
  <svg viewBox="0 0 760 316" role="img" aria-labelledby="chart-t chart-d" xmlns="http://www.w3.org/2000/svg">
    <title id="chart-t">Un giorno di produzione, consumi e ricarica dell'auto</title>
    <desc id="chart-d">La produzione fotovoltaica prevista sale fino a circa 5 kW a metà giornata. Il consumo della casa resta sotto 1 kW di giorno e sale a 2 kW la sera. Il solver assegna la ricarica dell'auto da 3,7 kW dalle 11 alle 15, quando il sole produce più di quanto la casa consuma.</desc>
    <line class="gl" x1="48" x2="740" y1="240.0" y2="240.0"/><text class="tick" x="40" y="244.0" text-anchor="end">0</text>
    <line class="gl" x1="48" x2="740" y1="166.7" y2="166.7"/><text class="tick" x="40" y="170.7" text-anchor="end">2</text>
    <line class="gl" x1="48" x2="740" y1="93.3" y2="93.3"/><text class="tick" x="40" y="97.3" text-anchor="end">4</text>
    <line class="gl" x1="48" x2="740" y1="20.0" y2="20.0"/><text class="tick" x="40" y="24.0" text-anchor="end">6</text>
    <text class="tick" x="40" y="12" text-anchor="end">kW</text>
    <text class="tick" x="48.0" y="306" text-anchor="middle">00</text>
    <text class="tick" x="221.0" y="306" text-anchor="middle">06</text>
    <text class="tick" x="394.0" y="306" text-anchor="middle">12</text>
    <text class="tick" x="567.0" y="306" text-anchor="middle">18</text>
    <text class="tick" x="740.0" y="306" text-anchor="middle">24</text>
    
    <line class="mark" x1={data.evSlot.x} x2={data.evSlot.x} y1="20" y2="282"/>
    <line class="mark" x1={data.evSlot.x + data.evSlot.width} x2={data.evSlot.x + data.evSlot.width} y1="20" y2="282"/>
    
    <path class="pv-area fadein" d={data.pvPath}/>
    <path class="sp fadein late" d={data.surplusPath}/>
    <path class="pv-line draw" pathLength="1" d={data.pvPath}/>
    <path class="ld-line draw" pathLength="1" d={data.loadPath}/>
    
    <text class="lbl lbl-sun" x="356" y="50" text-anchor="end">Produzione prevista</text>
    <text class="lbl lbl-grid" x="640" y="136" text-anchor="middle">Consumo casa</text>
    <text class="lbl lbl-plan fadein late" x="422.8" y="146" text-anchor="middle">surplus</text>
    
    <rect class="track" x="48" y="254" width="692" height="28" rx="3"/>
    <g class="fadein late">
      <rect class="ev" x={data.evSlot.x} y="254" width={data.evSlot.width} height="28" rx="3"/>
      <text class="ev-t" x={evMidX} y="273" text-anchor="middle">{data.evSlot.powerLabel}</text>
      <text class="lbl lbl-ink" x={evTextX} y="273">{data.evSlot.description}</text>
    </g>
  </svg>

  <figcaption>{data.caption}</figcaption>
</figure>
