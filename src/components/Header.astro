---
import { SITE_BRAND, NAVIGATION_LINKS, SOCIAL_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';
---

<header class="py-6 border-b border-[var(--rule)] bg-[var(--paper)] transition-colors">
  <div class="max-w-[1180px] mx-auto px-4 sm:px-8 flex items-baseline justify-between flex-wrap gap-4">
    <!-- Brand / Logo -->
    <a
      href="/"
      class="text-[1.65rem] font-extrabold tracking-tight [font-family:var(--f-display)] text-[var(--ink)] no-underline hover:text-[var(--grid)] transition-colors"
      style='font-variation-settings: "wdth" 80;'
    >
      {SITE_BRAND}
    </a>

    <!-- Navigazione Desktop -->
    <div class="flex items-center gap-6">
      <nav class="flex gap-6 text-[1rem] font-medium [font-family:var(--f-display)]" aria-label="Principale">
        {
          NAVIGATION_LINKS.map((link) => {
            const isActive = link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
            return (
              <a
                href={link.href}
                class={`no-underline py-1 border-b-2 transition-colors ${
                  isActive
                    ? 'border-[var(--sun)] text-[var(--ink)] font-semibold'
                    : 'border-transparent text-[var(--ink)] hover:border-[var(--sun)]'
                }`}
              >
                {link.name}
              </a>
            );
          })
        }
      </nav>

      <!-- Theme toggle e GitHub -->
      <div class="flex items-center gap-2 pl-4 border-l border-[var(--rule)]">
        <a
          href={SOCIAL_LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub di Alessandro Caliciotti"
          class="p-1.5 text-[var(--muted)] hover:text-[var(--ink)] transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
