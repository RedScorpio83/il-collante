---
interface Props {
  id: string;
  title: string;
  description: string;
  technologies: string[];
  pubDate: Date;
  status?: 'in-progress' | 'completed' | 'active';
  githubUrl?: string;
  liveUrl?: string;
  featured?: boolean;
}

const {
  id,
  title,
  description,
  technologies = [],
  status = 'active',
  githubUrl,
  liveUrl,
  featured = false,
} = Astro.props;

const statusLabels: Record<string, { label: string; class: string }> = {
  active: {
    label: 'Attivo',
    class: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800',
  },
  'in-progress': {
    label: 'In sviluppo',
    class: 'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border-amber-200 dark:border-amber-800',
  },
  completed: {
    label: 'Completato',
    class: 'bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border-blue-200 dark:border-blue-800',
  },
};

const currentStatus = statusLabels[status] || statusLabels.active;
---

<article class={`group relative flex flex-col justify-between p-6 rounded-2xl bg-white dark:bg-slate-900 border transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5 ${
  featured 
    ? 'border-sky-300 dark:border-sky-800/80 ring-1 ring-sky-400/20' 
    : 'border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700'
}`}>
  <div>
    <!-- Top header: Status badge & external links -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border ${currentStatus.class}`}>
        <span class="w-1.5 h-1.5 rounded-full bg-current mr-1.5 animate-pulse"></span>
        {currentStatus.label}
      </span>

      <div class="flex items-center gap-2">
        {
          githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors p-1"
              aria-label={`Codice sorgente di ${title}`}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            </a>
          )
        }
        {
          liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors p-1"
              aria-label={`Demo live di ${title}`}
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )
        }
      </div>
    </div>

    <!-- Title & Description -->
    <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
      <a href={`/projects/${id}`}>
        {title}
      </a>
    </h3>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed">
      {description}
    </p>
  </div>

  <!-- Tech tags & Case study link -->
  <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-2">
    <div class="flex flex-wrap gap-1.5">
      {
        technologies.map((tech) => (
          <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
            {tech}
          </span>
        ))
      }
    </div>
    <a
      href={`/projects/${id}`}
      class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
    >
      Dettagli & Architettura →
    </a>
  </div>
</article>
