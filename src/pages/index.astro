---
import BaseLayout from '../layouts/BaseLayout.astro';
import SolarChart from '../components/SolarChart.astro';
import Cover from '../components/Cover.astro';
import ArticleItem from '../components/ArticleItem.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SubscribeBox from '../components/SubscribeBox.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_TAGLINE, SITE_SUBTITLE, SOCIAL_LINKS } from '../consts';
import { getPostCategory } from '../utils/categories';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Fissiamo l'articolo 'Perché ho deciso di costruire in pubblico' come punto di partenza ideale per i nuovi visitatori
const featuredPost = allPosts.find((p) => p.id.includes('costruire-in-pubblico')) || allPosts[0];
const otherPosts = allPosts.filter((p) => p.id !== featuredPost?.id);

const allProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('it-IT', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
}
---

<BaseLayout title={SITE_TITLE}>
  <!-- Hero Section -->
  <section class="hero" aria-labelledby="titolo">
    <div>
      <h1 id="titolo">{SITE_TAGLINE}</h1>
      <p class="hero-lead">{SITE_SUBTITLE}</p>

      <div class="hero-start" style="margin-top: 1.25rem; padding: 0.75rem 1rem; background: var(--surface); border-left: 3px solid var(--sun); border-radius: var(--radius-s); font-size: 0.95rem;">
        <strong>Nuovo qui?</strong> Inizia dall'articolo guida:
        <a href={`/blog/${featuredPost?.id || 'benvenuti-costruire-in-pubblico'}`} style="font-weight: 600; text-decoration: underline;">Perché ho deciso di costruire in pubblico &rarr;</a>
      </div>

      <SubscribeBox inline={true} />

      <div class="hero-links">
        <a href="#progetti">Esplora i progetti</a>
        <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">Connettiti su LinkedIn</a>
        <a href="/rss.xml">Segui via RSS</a>
      </div>
    </div>

    <SolarChart />
  </section>

  <!-- L'impianto in numeri -->
  <dl class="stats" aria-label="L'impianto in numeri">
    <div class="stat">
      <dt class="stat-l">fotovoltaico installato</dt>
      <dd class="stat-n">25,05<span class="u">kWp</span></dd>
    </div>
    <div class="stat">
      <dt class="stat-l">accumulo LiFePO4</dt>
      <dd class="stat-n">36<span class="u">kWh</span></dd>
    </div>
    <div class="stat">
      <dt class="stat-l">inverter, in isola e in rete</dt>
      <dd class="stat-n">2</dd>
    </div>
  </dl>

  <!-- Ultimi Articoli -->
  <section class="sec" id="articoli" aria-labelledby="h-articoli" style="border-top:0">
    <div class="sec-head">
      <h2 id="h-articoli">Ultimi articoli</h2>
      <div class="filters" role="group" aria-label="Filtra per argomento">
        <button type="button" data-f="tutti" aria-pressed="true">Tutti</button>
        <button type="button" data-f="energia" aria-pressed="false">Energia</button>
        <button type="button" data-f="ottim" aria-pressed="false">Ottimizzazione</button>
        <button type="button" data-f="proto" aria-pressed="false">Protocolli ed embedded</button>
        <button type="button" data-f="sist" aria-pressed="false">Sistemi e IA</button>
      </div>
    </div>

    <div class="articles">
      {featuredPost && (() => {
        const cat = getPostCategory(featuredPost.data.tags);
        return (
          <article class="featured">
            <Cover
              href={`/blog/${featuredPost.id}`}
              categoryClass={cat.class}
              label={cat.label}
              image={featuredPost.data.cover}
              alt={`Copertina di ${featuredPost.data.title}`}
            />
            <div class="meta">
              <span class="cat" style="background: var(--ink); color: var(--paper); font-weight: 700;">Inizia da qui</span>
              <span>{formatDate(featuredPost.data.pubDate)}</span>
              <span class={`cat ${cat.class}`}><i aria-hidden="true"></i>{cat.label}</span>
            </div>
            <h3><a href={`/blog/${featuredPost.id}`}>{featuredPost.data.title}</a></h3>
            <p>{featuredPost.data.description}</p>
            <a class="more" href={`/blog/${featuredPost.id}`}>Leggi l'articolo</a>
          </article>
        );
      })()}

      <div class="list" id="lista">
        {otherPosts.map((post) => (
          <ArticleItem
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            cover={post.data.cover}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Progetti e Infrastrutture -->
  <section class="sec" id="progetti" aria-labelledby="h-progetti">
    <div class="sec-head">
      <div>
        <h2 id="h-progetti">Progetti e infrastrutture</h2>
        <p class="sec-lead">Sistemi realizzati sul campo, con schema e documentazione.</p>
      </div>
      <a class="more" href="/projects">Vedi tutti i progetti</a>
    </div>
    <div class="projects-list">
      {allProjects.slice(0, 3).map((project) => (
        <ProjectRow
          id={project.id}
          title={project.data.title}
          description={project.data.description}
          technologies={project.data.technologies}
          status={project.data.status}
          highlight={project.data.highlight}
        />
      ))}
    </div>
  </section>

  <!-- Chi scrive -->
  <section class="sec" id="chi-scrive" aria-labelledby="h-chi">
    <div class="about">
      <h2 id="h-chi">Chi scrive</h2>
      <div>
        <p><strong>Alessandro Caliciotti</strong> &mdash; System integrator e progettista di soluzioni energetiche. Da oltre vent'anni lavoro sul campo con hardware, reti e sistemi operativi; gestisco una centrale solare da 25 kWp, 36 kWh di batterie LiFePO4 e nodi Proxmox bare-metal.</p>
        <p>Non scrivo a mano ogni singola riga di codice: trovo la soluzione fisica e matematica, disegno l'architettura complessiva e faccio da <em>collante</em> tra chi gestisce il ferro, i protocolli industriali e l'intelligenza artificiale.</p>
        <div class="about-links">
          <a class="btn" href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">Connettiti su LinkedIn</a>
          <a class="btn btn--ghost" href="/about">Chi sono &rarr;</a>
          <a class="btn btn--ghost" href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
