---
import { SITE_BRAND } from '../consts';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';
---

<header class="top">
  <a class="brand" href="/">{SITE_BRAND}</a>
  <nav class="nav" aria-label="Principale">
    <a href="/blog" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>Articoli</a>
    <a href="/projects" aria-current={currentPath.startsWith('/projects') ? 'page' : undefined}>Progetti</a>
    <a href="/about" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>Chi scrive</a>
    <a href="/rss.xml">RSS</a>
  </nav>
</header>
