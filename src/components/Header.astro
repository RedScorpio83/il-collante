---
import { SITE_BRAND } from '../consts';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';
---

<header class="top">
  <a class="brand" href="/" aria-label="Torna alla home de Il collante">
    <svg class="brand-logo" viewBox="0 0 38 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Hardware Node (Sinistra: Ingranaggio / Ferro) -->
      <path d="M8.5 2.5 L15.5 6.5 L15.5 19.5 L8.5 23.5 L1.5 19.5 L1.5 6.5 Z" stroke="var(--ink)" stroke-width="1.8" stroke-linejoin="round" />
      <circle cx="8.5" cy="13" r="2.8" stroke="var(--ink)" stroke-width="1.4" />
      <circle cx="8.5" cy="13" r="1.2" fill="var(--ink)" />

      <!-- Software / AI Node (Destra: Rete / Modbus / Piste) -->
      <path d="M29.5 2.5 L36.5 6.5 L36.5 19.5 L29.5 23.5 L22.5 19.5 L22.5 6.5 Z" stroke="var(--grid)" stroke-width="1.8" stroke-linejoin="round" />
      <circle cx="29.5" cy="13" r="1.6" fill="var(--grid)" />
      <circle cx="26" cy="9.5" r="1.1" fill="var(--grid)" />
      <circle cx="33" cy="9.5" r="1.1" fill="var(--grid)" />
      <circle cx="26" cy="16.5" r="1.1" fill="var(--grid)" />
      <circle cx="33" cy="16.5" r="1.1" fill="var(--grid)" />
      <line x1="26" y1="9.5" x2="29.5" y2="13" stroke="var(--grid)" stroke-width="1" />
      <line x1="33" y1="9.5" x2="29.5" y2="13" stroke="var(--grid)" stroke-width="1" />
      <line x1="26" y1="16.5" x2="29.5" y2="13" stroke="var(--grid)" stroke-width="1" />
      <line x1="33" y1="16.5" x2="29.5" y2="13" stroke="var(--grid)" stroke-width="1" />

      <!-- Il Collante (Ponte ad arco oro solare) -->
      <path d="M8.5 13 C12 8.5, 26 8.5, 29.5 13" stroke="var(--sun)" stroke-width="2.6" stroke-linecap="round" />
      <circle cx="8.5" cy="13" r="1.8" fill="var(--sun)" />
      <circle cx="29.5" cy="13" r="1.8" fill="var(--sun)" />
    </svg>
    <span>{SITE_BRAND}</span>
  </a>
  <nav class="nav" aria-label="Principale">
    <a href="/blog" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>Articoli</a>
    <a href="/projects" aria-current={currentPath.startsWith('/projects') ? 'page' : undefined}>Progetti</a>
    <a href="/about" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>Chi scrive</a>
    <a href="/rss.xml">RSS</a>
  </nav>
</header>
